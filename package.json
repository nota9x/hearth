{
  "name": "hearth",
  "version": "0.1.0",
  "description": "A private, invitation-only ShareX image host on Cloudflare Workers.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "dev": "node --import tsx scripts/development.ts",
    "dev:web": "node --import tsx scripts/development.ts web",
    "build": "pnpm --filter @hearth/web build",
    "check": "pnpm --filter @hearth/web check && tsc --noEmit",
    "lint": "pnpm --filter @hearth/web exec svelte-kit sync && eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "configure": "tsx scripts/configure.ts",
    "format": "prettier --write .",
    "fmt": "pnpm format",
    "preview": "node --import tsx scripts/preview.ts",
    "dev:delivery": "node --import tsx scripts/development.ts delivery",
    "dev:maintenance": "node --import tsx scripts/development.ts maintenance",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --config apps/web/wrangler.jsonc",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "typegen": "wrangler types packages/core/bindings.d.ts --config apps/web/wrangler.jsonc --env-interface CloudflareEnv && wrangler types packages/core/delivery-bindings.d.ts --config workers/delivery/wrangler.jsonc --env-interface DeliveryBindings --include-runtime false --strict-vars false",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:benchmark": "vitest run --config vitest.benchmark.config.ts",
    "storage:initialize": "tsx scripts/storage-initialize.ts"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.3",
    "drizzle-orm": "^0.45.4",
    "image-size": "^2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "@xterm/headless": "^6.0.0",
    "@zip.js/zip.js": "2.23.0",
    "croner": "^10.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "lefthook": "2.2.1",
    "log-update": "^8.0.0",
    "miniflare": "5.20260918.0-alpha",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0",
    "wrap-ansi": "^10.0.2"
  },
  "imports": {
    "#lib/*": "./apps/web/src/lib/*"
  }
}
